generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Movie {
  id          String      @id @default(uuid())
  title       String
  description String?
  status      MovieStatus

  versions MovieVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MovieVersion {
  id      String @id @default(uuid())
  movieId String
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Restrict)

  versionType     String // IMAX | 2D | 3D | DC
  durationMinutes Int

  createdAt DateTime @default(now())

  @@index([movieId])
}

enum MovieStatus {
  COMING_SOON
  NOW_SHOWING
  ENDED
}

model Cinema {
  id        String   @id @default(uuid())
  name      String
  city      String
  address   String?
  halls     Hall[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Hall {
  id         String     @id @default(uuid())
  name       String
  totalSeats Int
  cinemaId   String
  cinema     Cinema     @relation(fields: [cinemaId], references: [id])
  seats      Seat[]
  showtimes  Showtime[]
  createdAt  DateTime   @default(now())
}

model Showtime {
  id             String @id @default(uuid())
  movieVersionId String

  hallId String
  hall   Hall   @relation(fields: [hallId], references: [id])

  startTime   DateTime
  endTime     DateTime
  priceConfig Json
  createdAt   DateTime @default(now())

  @@index([hallId, startTime])
  @@index([movieVersionId])
}

model Seat {
  id         String   @id @default(uuid())
  hallId     String
  hall       Hall     @relation(fields: [hallId], references: [id])

  rowCode    String
  seatNumber Int

  gridRow    Int
  gridCol    Int

  type       SeatType

  createdAt  DateTime @default(now())

  @@unique([hallId, rowCode, seatNumber])
}


enum SeatType {
  STANDARD
  VIP
  COUPLE
}

